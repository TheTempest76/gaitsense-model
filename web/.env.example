# Copy to .env.local and fill in. Next.js loads .env.local automatically;
# it's gitignored (see .gitignore's `!.env.example` exception, which is why
# this file specifically stays tracked).

# Must equal GAITSENSE_DEVICE_TOKEN in the firmware's `idf.py menuconfig` —
# the ESP32 sends this as the X-Device-Token header on every /api/ingest POST.
GAITSENSE_TOKEN=change-me

# Optional: override the SQLite file location (default: web/gaitsense.db).
# DATABASE_PATH=./gaitsense.db
